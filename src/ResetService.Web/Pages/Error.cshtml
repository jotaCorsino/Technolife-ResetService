@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro inesperado";
}

<h1>Erro inesperado</h1>
<p>Não foi possível concluir a operação.</p>
<p>Se precisar de ajuda, informe o código da solicitação ao responsável.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Código da solicitação:</strong> <code>@Model.RequestId</code>
    </p>
}
